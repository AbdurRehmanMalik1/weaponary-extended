{
  "model": {
    "type": "minecraft:condition",
    "on_false": {
      "type": "minecraft:condition",
      "on_false": {
        "type": "minecraft:model",
        "model": "weaponry:item/rapid_crossbow"
      },
      "on_true": {
        "type": "minecraft:model",
        "model": "weaponry:item/rapid_crossbow_arrow"
      },
      "property": "weaponry:crossbow/loaded"
    },
    "on_true": {
      "type": "minecraft:range_dispatch",
      "entries": [
        {
          "model": {
            "type": "minecraft:model",
            "model": "weaponry:item/rapid_crossbow_pulling_1"
          },
          "threshold": 0.58
        },
        {
          "model": {
            "type": "minecraft:model",
            "model": "weaponry:item/rapid_crossbow_pulling_2"
          },
          "threshold": 1.0
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "weaponry:item/rapid_crossbow_pulling_0"
      },
      "property": "weaponry:crossbow/fill"
    },
    "property": "minecraft:using_item"
  }
}