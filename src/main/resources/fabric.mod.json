{
	"schemaVersion": 1,
	"id": "weaponry",
	"version": "${version}",
	"name": "Weaponry",
	"description": "Daggers, sabres, scimitars, spears, pikes, lances, halberds, hatchets, war hammers, clubs and more in every vanilla material tier, plus four bows.",
	"authors": [
		"firstwemine1-mc-dev"
	],
	"license": "MIT",
	"icon": "assets/weaponry/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.firstwemine1.weaponry.Weaponry"
		],
		"client": [
			"net.firstwemine1.weaponry.client.WeaponryClient"
		],
		"fabric-datagen": [
			"net.firstwemine1.weaponry.datagen.WeaponryDataGenerator"
		]
	},
	"mixins": [
		"weaponry.mixins.json",
		{
			"config": "weaponry.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}
